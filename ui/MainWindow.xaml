<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code Wakeup Alarm"
        Width="1120" Height="740"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F1115"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="assets/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#FF161A22" BorderBrush="#FF2E3648" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Claude Code Wakeup Alarm" FontSize="20" FontWeight="SemiBold" Foreground="#FFF2F4F8"/>
          <TextBlock Text="Never miss when Claude needs you." FontSize="12" Foreground="#FF9AA3B5" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="PillAlarm" Background="#FF1C2230" CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
            <TextBlock x:Name="TxtPillAlarm" Text="Alarm Enabled" Foreground="#FF3DDC97" FontSize="11"/>
          </Border>
          <Border x:Name="PillHooks" Background="#FF1C2230" CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
            <TextBlock x:Name="TxtPillHooks" Text="Hooks" Foreground="#FF9AA3B5" FontSize="11"/>
          </Border>
          <Border x:Name="PillReady" Background="#FF1C2230" CornerRadius="12" Padding="10,5">
            <TextBlock x:Name="TxtPillReady" Text="Monitoring Ready" Foreground="#FF9AA3B5" FontSize="11"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="#FF12151C" BorderBrush="#FF2E3648" BorderThickness="0,0,1,0" Padding="8,16">
        <StackPanel>
          <Button x:Name="NavDashboard" Style="{StaticResource NavButtonActive}" Content="Dashboard" Tag="Dashboard"/>
          <Button x:Name="NavEvents" Style="{StaticResource NavButton}" Content="Events" Tag="Events"/>
          <Button x:Name="NavAlarm" Style="{StaticResource NavButton}" Content="Alarm" Tag="Alarm"/>
          <Button x:Name="NavVideos" Style="{StaticResource NavButton}" Content="Videos" Tag="Videos"/>
          <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Content="Logs" Tag="Logs"/>
          <Button x:Name="NavSetup" Style="{StaticResource NavButton}" Content="Setup" Tag="Setup"/>
          <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Settings" Tag="Settings"/>
        </StackPanel>
      </Border>

      <!-- Content -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
        <Grid>
          <!-- DASHBOARD -->
          <StackPanel x:Name="PageDashboard" Visibility="Visible">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Wakeup Alarm" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="TxtScopeBadge" Text="GLOBAL" Foreground="#FF5B8CFF" FontSize="11" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtAlarmToggleLabel" Text="OFF" Foreground="#FF9AA3B5" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <CheckBox x:Name="ChkAlarmMaster" Content="" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

            <UniformGrid Columns="2" Margin="0,0,0,12">
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                <StackPanel>
                  <TextBlock Text="Claude Code" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtDashClaude" Text="Not Detected" Foreground="#FFF2F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                  <TextBlock x:Name="TxtDashClaudeVer" Text="" Foreground="#FF6B7385" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="8,0,0,8">
                <StackPanel>
                  <TextBlock Text="Hooks" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtDashHooks" Text="Not Installed" Foreground="#FFF2F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                <StackPanel>
                  <TextBlock Text="Alarm" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtDashAlarm" Text="Disabled" Foreground="#FFF2F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="8,0,0,8">
                <StackPanel>
                  <TextBlock Text="Video Player" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtDashPlayer" Text="Windows Fallback" Foreground="#FFF2F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                <StackPanel>
                  <TextBlock Text="Configuration" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtDashConfig" Text="Global" Foreground="#FFF2F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="8,0,0,8">
                <StackPanel>
                  <TextBlock Text="Current User Idle Time" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtDashIdle" Text="0 sec" Foreground="#FFF2F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                <StackPanel>
                  <TextBlock Text="Last Event" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtDashLastEvent" Text="-" Foreground="#FFF2F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="8,0,0,8">
                <StackPanel>
                  <TextBlock Text="Last Alarm" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtDashLastAlarm" Text="-" Foreground="#FFF2F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Button x:Name="BtnTestAlarm" Style="{StaticResource TestAlarmButton}" Content="TEST ALARM" Margin="0,4,0,16" HorizontalAlignment="Stretch"/>

            <TextBlock Text="Live Status" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource CardBorder}">
              <UniformGrid Columns="3">
                <StackPanel Margin="0,0,8,8">
                  <TextBlock Text="Claude Event" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtLiveEvent" Text="-" Foreground="#FFF2F4F8" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,8">
                  <TextBlock Text="Idle" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtLiveIdle" Text="0 sec" Foreground="#FFF2F4F8" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,8">
                  <TextBlock Text="Alarm" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtLiveAlarm" Text="IDLE" Foreground="#FFF2F4F8" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="Worker" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtLiveWorker" Text="Idle" Foreground="#FFF2F4F8" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="Current Video" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtLiveVideo" Text="-" Foreground="#FFF2F4F8" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Lock" Foreground="#FF9AA3B5" FontSize="11"/>
                  <TextBlock x:Name="TxtLiveLock" Text="Free" Foreground="#FFF2F4F8" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
              </UniformGrid>
            </Border>

            <TextBlock Text="Recent Activity" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
            <Border Style="{StaticResource CardBorder}">
              <ItemsControl x:Name="ListRecentActivity"/>
            </Border>

            <TextBlock Text="Simulate Events" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
            <WrapPanel>
              <Button x:Name="BtnSimPermission" Style="{StaticResource GhostButton}" Content="Simulate Permission Request" Margin="0,0,8,8"/>
              <Button x:Name="BtnSimNeedsInput" Style="{StaticResource GhostButton}" Content="Simulate Agent Needs Input" Margin="0,0,8,8"/>
              <Button x:Name="BtnSimCompleted" Style="{StaticResource GhostButton}" Content="Simulate Agent Completed" Margin="0,0,8,8"/>
              <Button x:Name="BtnSimFinished" Style="{StaticResource GhostButton}" Content="Simulate Claude Finished" Margin="0,0,8,8"/>
            </WrapPanel>
          </StackPanel>

          <!-- EVENTS -->
          <StackPanel x:Name="PageEvents" Visibility="Collapsed">
            <TextBlock Text="Notification Events" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Choose when the wakeup alarm should arm." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <CheckBox x:Name="ChkEvPermission" Style="{StaticResource DarkCheckBox}" Content="Permission Required"/>
                <TextBlock Text="Alert me when Claude needs approval to continue." Style="{StaticResource MutedText}" Margin="24,0,0,10"/>
                <CheckBox x:Name="ChkEvIdle" Style="{StaticResource DarkCheckBox}" Content="Idle / Waiting"/>
                <TextBlock Text="Alert me when Claude Code nudges that it is still waiting." Style="{StaticResource MutedText}" Margin="24,0,0,10"/>
                <CheckBox x:Name="ChkEvNeedsInput" Style="{StaticResource DarkCheckBox}" Content="Agent Needs Input"/>
                <TextBlock Text="Alert me when Claude is waiting for an answer." Style="{StaticResource MutedText}" Margin="24,0,0,10"/>
                <CheckBox x:Name="ChkEvCompleted" Style="{StaticResource DarkCheckBox}" Content="Agent Completed"/>
                <TextBlock Text="Alert me when a background agent finishes its work." Style="{StaticResource MutedText}" Margin="24,0,0,10"/>
                <CheckBox x:Name="ChkEvStop" Style="{StaticResource DarkCheckBox}" Content="Claude Finished"/>
                <TextBlock Text="Alert me when Claude finishes responding." Style="{StaticResource MutedText}" Margin="24,0,0,4"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ALARM -->
          <StackPanel x:Name="PageAlarm" Visibility="Collapsed">
            <TextBlock Text="Alarm Settings" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Tune grace period, idle gate, and playback limits." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Grace Period" Foreground="#FFF2F4F8"/>
                  <TextBlock x:Name="LblDelay" Text="10s" Foreground="#FF5B8CFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SldDelay" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="60" Value="10"/>
                <DockPanel>
                  <TextBlock Text="Idle Threshold" Foreground="#FFF2F4F8"/>
                  <TextBlock x:Name="LblIdle" Text="15s" Foreground="#FF5B8CFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SldIdle" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="120" Value="15"/>
                <DockPanel>
                  <TextBlock Text="Return Detection" Foreground="#FFF2F4F8"/>
                  <TextBlock x:Name="LblReturn" Text="2s" Foreground="#FF5B8CFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SldReturn" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="10" Value="2"/>
                <DockPanel>
                  <TextBlock Text="Maximum Alarm Duration" Foreground="#FFF2F4F8"/>
                  <TextBlock x:Name="LblMax" Text="120s" Foreground="#FF5B8CFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SldMax" Style="{StaticResource DarkSlider}" Minimum="10" Maximum="600" Value="120"/>
                <CheckBox x:Name="ChkLoop" Style="{StaticResource DarkCheckBox}" Content="Loop Alarm"/>
                <CheckBox x:Name="ChkEnabled" Style="{StaticResource DarkCheckBox}" Content="Alarm Enabled"/>
                <Button x:Name="BtnSaveAlarm" Style="{StaticResource PrimaryButton}" Content="SAVE SETTINGS" Margin="0,16,0,0" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- VIDEOS -->
          <StackPanel x:Name="PageVideos" Visibility="Collapsed">
            <TextBlock Text="Video Settings" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Choose MP4, MKV, MOV, or WebM clips for the alarm." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Selected Alarm Video" Foreground="#FF9AA3B5" FontSize="11"/>
                <TextBlock x:Name="TxtSelectedVideo" Text="(random from media/)" Foreground="#FFF2F4F8" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,4" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtVideoInfo" Text="" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <RadioButton x:Name="RadVideoRandom" Content="Randomly select videos" Foreground="#FFF2F4F8" Margin="0,0,16,0" GroupName="VideoMode" IsChecked="True"/>
                  <RadioButton x:Name="RadVideoFixed" Content="Use selected video" Foreground="#FFF2F4F8" GroupName="VideoMode"/>
                </StackPanel>
                <ListBox x:Name="ListVideos" Height="180" Background="#FF12151C" Foreground="#FFF2F4F8" BorderBrush="#FF2E3648" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button x:Name="BtnBrowseVideo" Style="{StaticResource GhostButton}" Content="Browse &amp; Add" Margin="0,0,8,8"/>
                  <Button x:Name="BtnPreviewVideo" Style="{StaticResource GhostButton}" Content="Preview" Margin="0,0,8,8"/>
                  <Button x:Name="BtnRemoveVideo" Style="{StaticResource DangerButton}" Content="Remove" Margin="0,0,8,8"/>
                  <Button x:Name="BtnTestVideo" Style="{StaticResource PrimaryButton}" Content="TEST VIDEO" Margin="0,0,8,8"/>
                  <Button x:Name="BtnSaveVideo" Style="{StaticResource PrimaryButton}" Content="SAVE SETTINGS" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Player" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <RadioButton x:Name="RadPlayerAuto" Content="Auto" Foreground="#FFF2F4F8" Margin="0,0,16,0" GroupName="Player" IsChecked="True"/>
                  <RadioButton x:Name="RadPlayerFFplay" Content="FFplay" Foreground="#FFF2F4F8" Margin="0,0,16,0" GroupName="Player"/>
                  <RadioButton x:Name="RadPlayerWindows" Content="Windows Media fallback" Foreground="#FFF2F4F8" GroupName="Player"/>
                </StackPanel>
                <TextBlock x:Name="TxtFFplayStatus" Text="FFplay detection..." Style="{StaticResource MutedText}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- LOGS -->
          <StackPanel x:Name="PageLogs" Visibility="Collapsed">
            <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Historical decisions from the wakeup engine. Clearing the view does not delete the file." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="BtnLogRefresh" Style="{StaticResource GhostButton}" Content="Refresh" Margin="0,0,8,0"/>
              <Button x:Name="BtnLogClear" Style="{StaticResource GhostButton}" Content="Clear View" Margin="0,0,8,0"/>
              <Button x:Name="BtnLogOpen" Style="{StaticResource PrimaryButton}" Content="Open Log File"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorder}" Padding="0">
              <DataGrid x:Name="GridLogs" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column"
                        Background="#FF1C2230" Foreground="#FFF2F4F8" BorderThickness="0"
                        RowBackground="#FF1C2230" AlternatingRowBackground="#FF161A22"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF2E3648"
                        CanUserAddRows="False" Height="420"/>
            </Border>
          </StackPanel>

          <!-- SETUP -->
          <StackPanel x:Name="PageSetup" Visibility="Collapsed">
            <TextBlock Text="Installation" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Install Claude Code hooks safely. Unrelated settings are never overwritten." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Claude Code Installation" Foreground="#FF9AA3B5"/><TextBlock x:Name="TxtSetupClaude" Text="Not Detected" Foreground="#FFF2F4F8" HorizontalAlignment="Right"/></DockPanel>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Claude Settings" Foreground="#FF9AA3B5"/><TextBlock x:Name="TxtSetupSettings" Text="-" Foreground="#FFF2F4F8" HorizontalAlignment="Right"/></DockPanel>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Global Hooks" Foreground="#FF9AA3B5"/><TextBlock x:Name="TxtSetupGlobal" Text="Not Installed" Foreground="#FFF2F4F8" HorizontalAlignment="Right"/></DockPanel>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Project Hooks" Foreground="#FF9AA3B5"/><TextBlock x:Name="TxtSetupProject" Text="Not Installed" Foreground="#FFF2F4F8" HorizontalAlignment="Right"/></DockPanel>
                <DockPanel><TextBlock Text="Cursor Integration" Foreground="#FF9AA3B5"/><TextBlock x:Name="TxtSetupCursor" Text="-" Foreground="#FFF2F4F8" HorizontalAlignment="Right"/></DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Cursor Integration" FontWeight="SemiBold" Foreground="#FFF2F4F8" Margin="0,0,0,6"/>
                <TextBlock Text="No Cursor extension is required. Claude Wakeup Alarm automatically works with Claude Code running inside Cursor's terminal." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button x:Name="BtnInstallGlobal" Style="{StaticResource PrimaryButton}" Content="INSTALL GLOBALLY" Margin="0,0,8,8"/>
                  <Button x:Name="BtnInstallProject" Style="{StaticResource GhostButton}" Content="INSTALL FOR CURRENT PROJECT" Margin="0,0,8,8"/>
                  <Button x:Name="BtnUninstallGlobal" Style="{StaticResource DangerButton}" Content="UNINSTALL GLOBAL" Margin="0,0,8,8"/>
                  <Button x:Name="BtnUninstallProject" Style="{StaticResource DangerButton}" Content="UNINSTALL PROJECT" Margin="0,0,8,8"/>
                  <Button x:Name="BtnVerify" Style="{StaticResource GhostButton}" Content="VERIFY INSTALLATION" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- SETTINGS -->
          <StackPanel x:Name="PageSettings" Visibility="Collapsed">
            <TextBlock Text="Configuration Management" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Hook Scope" Foreground="#FFF2F4F8" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <RadioButton x:Name="RadScopeGlobal" Content="Global Claude Hooks" Foreground="#FFF2F4F8" Margin="0,0,16,0" GroupName="Scope" IsChecked="True"/>
                  <RadioButton x:Name="RadScopeProject" Content="Current Project Hooks" Foreground="#FFF2F4F8" GroupName="Scope"/>
                </StackPanel>
                <TextBlock Text="Project directory" Foreground="#FF9AA3B5" FontSize="11"/>
                <DockPanel Margin="0,4,0,12">
                  <Button x:Name="BtnBrowseProject" Style="{StaticResource GhostButton}" Content="Browse" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <TextBox x:Name="TxtProjectPath" Background="#FF12151C" Foreground="#FFF2F4F8" BorderBrush="#FF2E3648" Padding="8" VerticalContentAlignment="Center"/>
                </DockPanel>
                <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource DarkCheckBox}" Content="Start Manager with Windows"/>
                <TextBlock Text="Default OFF. Only starts the management UI - hooks do not need this." Style="{StaticResource MutedText}" Margin="24,0,0,8"/>
                <CheckBox x:Name="ChkMinimizeTray" Style="{StaticResource DarkCheckBox}" Content="Minimize to tray when closing"/>
                <Button x:Name="BtnSaveSettings" Style="{StaticResource PrimaryButton}" Content="SAVE SETTINGS" Margin="0,16,0,0" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Toast -->
    <Border x:Name="ToastBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="#FF242B3A" CornerRadius="10" Padding="16,10" Margin="0,0,0,24" Visibility="Collapsed">
      <TextBlock x:Name="TxtToast" Text="" Foreground="#FF3DDC97" FontSize="13"/>
    </Border>

    <!-- First-run wizard overlay -->
    <Grid x:Name="WizardOverlay" Grid.RowSpan="2" Background="#CC0F1115" Visibility="Collapsed">
      <Border Background="#FF1C2230" CornerRadius="16" Width="520" Height="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnWizardBack" Style="{StaticResource GhostButton}" Content="Back" Margin="0,0,8,0"/>
            <Button x:Name="BtnWizardNext" Style="{StaticResource PrimaryButton}" Content="Next"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Welcome" FontSize="22" FontWeight="SemiBold" Foreground="#FFF2F4F8"/>
            <TextBlock x:Name="TxtWizardStep" Text="Step 1 of 5" Foreground="#FF5B8CFF" Margin="0,4,0,16"/>
            <TextBlock x:Name="TxtWizardTitle" Text="Detect Claude Code" FontSize="16" FontWeight="SemiBold" Foreground="#FFF2F4F8" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtWizardBody" Text="" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <TextBlock x:Name="TxtWizardStatus" Text="" Foreground="#FF3DDC97" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
